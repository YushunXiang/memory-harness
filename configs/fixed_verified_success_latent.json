{
  "name": "verified_success_latent",
  "deployable": true,
  "paths": [
    {
      "name": "success",
      "encoder": {
        "type": "tokens",
        "options": {"max_tokens": 1}
      },
      "writer": {"type": "always"},
      "store": {
        "type": "verified_success_ring",
        "options": {"capacity": 30}
      },
      "retriever": {"type": "all"},
      "lifecycle": {"type": "episode"}
    }
  ],
  "controller": {"type": "all"},
  "utilizer": {
    "type": "mem0_context",
    "options": {
      "embed_dim": 2048,
      "sliding_window_size": 30,
      "anchor_path": null,
      "history_path_quotas": {"success": 30}
    }
  }
}
