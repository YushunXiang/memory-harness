{
  "name": "anchor_sliding",
  "deployable": true,
  "paths": [
    {
      "name": "anchor",
      "encoder": {
        "type": "tokens",
        "options": {"max_tokens": 1}
      },
      "writer": {"type": "first"},
      "store": {"type": "anchor"},
      "retriever": {"type": "all"},
      "lifecycle": {"type": "phase"}
    },
    {
      "name": "sliding",
      "encoder": {
        "type": "tokens",
        "options": {"max_tokens": 1}
      },
      "writer": {"type": "always"},
      "store": {
        "type": "ring",
        "options": {"capacity": 30}
      },
      "retriever": {
        "type": "latest",
        "options": {"max_items": 30}
      },
      "lifecycle": {"type": "phase"}
    }
  ],
  "controller": {"type": "all"},
  "utilizer": {
    "type": "mem0_context",
    "options": {
      "embed_dim": 2048,
      "sliding_window_size": 30,
      "anchor_path": "anchor",
      "history_path_quotas": {"sliding": 30}
    }
  }
}
