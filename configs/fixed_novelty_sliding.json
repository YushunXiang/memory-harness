{
  "name": "novelty_sliding",
  "deployable": true,
  "paths": [
    {
      "name": "sliding",
      "encoder": {
        "type": "tokens",
        "options": {"max_tokens": 1}
      },
      "writer": {
        "type": "novelty",
        "options": {
          "min_cosine_distance": 0.0003,
          "max_steps_without_write": 30
        }
      },
      "store": {
        "type": "ring",
        "options": {"capacity": 30}
      },
      "retriever": {
        "type": "latest",
        "options": {"max_items": 30}
      },
      "lifecycle": {"type": "phase"}
    }
  ],
  "controller": {"type": "all"},
  "utilizer": {
    "type": "mem0_context",
    "options": {
      "embed_dim": 2048,
      "sliding_window_size": 30,
      "anchor_path": null,
      "history_path_quotas": {"sliding": 30}
    }
  }
}
